# Edge Caddy site blocks for bruchner.dev.
#
# Applied by hand on the host, never by CI: see deploy/README.md.
# No `log` directive: the site keeps no access logs, as /privacy/ states.

import security-headers.caddy

bruchner.dev {
	root * /srv/bruchner.dev/site
	encode zstd gzip
	import bruchner_dev_headers

	# Hashed build assets never change; everything else revalidates.
	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@revalidate not path /_astro/*
	header @revalidate Cache-Control "no-cache"

	# The bare domain picks a language: German for browsers that prefer it,
	# English otherwise. Temporary, so the choice is made on every visit.
	@root_de {
		path /
		header_regexp Accept-Language ^\s*de
	}
	@root path /
	header @root Vary Accept-Language
	# Both matchers are named, so the two redirects keep this order.
	redir @root_de /de/ 302
	redir @root /en/ 302

	# English pages moved under /en/ when the German version arrived (2026-09).
	# The build also ships static redirect pages at these paths as a fallback.
	@moved path_regexp ^/(services|work|cv|writing|legal|privacy|hello-world|still-alive|freelance-availability|leaving-linkedin|relaunch)(/.*)?$
	redir @moved /en{uri} permanent

	# Old URLs that no longer exist.
	@resume path /resume /resume/
	redir @resume /en/cv/ permanent
	@home path /about /about/ /notes /notes/ /thanks /thanks/
	redir @home / permanent
	@tags path /tags /tags/
	redir @tags /en/writing/ permanent
	@june path /looking-for-something-new /looking-for-something-new/
	redir @june /en/relaunch/ permanent
	redir /sitemap.xml /sitemap-index.xml permanent

	file_server

	# handle_errors runs a separate route that does not inherit the headers above.
	handle_errors 404 {
		import bruchner_dev_headers
		header Cache-Control "no-cache"
		rewrite * /404.html
		file_server
	}
}

www.bruchner.dev {
	redir https://bruchner.dev{uri} permanent
}

# The previous domain: every path redirects to the same path here, where the
# old-URL redirects above take over.
phhbr.de, www.phhbr.de {
	redir https://bruchner.dev{uri} permanent
}

---
interface Props {
  quote: string;
  role: string;
  // Where the person worked with me, in the page's language.
  context: string;
}

const { quote, role, context } = Astro.props;
---

<figure class="testimonial">
  {/* Quotes are kept in the English they were written in. */}
  <blockquote lang="en">
    <p>{quote}</p>
  </blockquote>
  <figcaption>{role}, {context}</figcaption>
</figure>

<style>
  .testimonial {
    margin: 0;
    padding-left: var(--space-3);
    border-left: 2px solid var(--accent);
  }

  blockquote {
    margin: 0 0 var(--space-1);
  }

  blockquote p {
    margin: 0;
    font-size: var(--step-0);
  }

  blockquote p::before {
    content: '“';
  }

  blockquote p::after {
    content: '”';
  }

  figcaption {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
</style>

---
import { SITE } from '../config';
---

<p class="reach">
  <a class="button" href={`mailto:${SITE.email}`}>Email {SITE.email}</a>
  <span>or call <a href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a></span>
</p>

<style>
  .reach {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
</style>

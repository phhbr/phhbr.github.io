# Edge Caddy site blocks for bruchner.dev (migration plan 4.1).
#
# Applied by hand on the host, never by CI: copy both deploy/*.caddy files to
# /etc/caddy/sites/, import this file from the main Caddyfile, then
# `caddy validate` and `systemctl reload caddy`. See deploy/README.md.
#
# No `log` directive: the site keeps no access logs, as /privacy/ states.

import security-headers.caddy

# Headers for every response, including error pages (handle_errors runs a
# separate route that does not inherit them). The launch switch lives here:
# 5.1 report-only + noindex; 5.2 Content-Security-Policy, no X-Robots-Tag.
(bruchner_dev_response_headers) {
	import bruchner_dev_headers Content-Security-Policy-Report-Only
	header X-Robots-Tag "noindex"
}

bruchner.dev {
	root * /srv/bruchner.dev/site
	encode zstd gzip

	import bruchner_dev_response_headers

	# Hashed build assets never change; everything else revalidates.
	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@revalidate not path /_astro/*
	header @revalidate Cache-Control "no-cache"

	# Jekyll URLs that no longer exist (legacy URL table in the plan).
	@resume path /resume /resume/
	redir @resume /cv/ permanent
	@home path /about /about/ /notes /notes/ /thanks /thanks/
	redir @home / permanent
	@tags path /tags /tags/
	redir @tags /writing/ permanent
	@june path /looking-for-something-new /looking-for-something-new/
	redir @june /relaunch/ permanent
	redir /sitemap.xml /sitemap-index.xml permanent

	file_server

	handle_errors 404 {
		import bruchner_dev_response_headers
		header Cache-Control "no-cache"
		rewrite * /404.html
		file_server
	}
}

www.bruchner.dev {
	redir https://bruchner.dev{uri} permanent
}

# 5.4: uncomment once phhbr.de's A/AAAA records point at this host.
# phhbr.de, www.phhbr.de {
# 	redir https://bruchner.dev{uri} permanent
# }

---
import { SITE } from '../config';
import { langOf, ui } from '../i18n';

const t = ui[langOf(Astro.url)];
---

<p class="reach">
  <a class="button" href={`mailto:${SITE.email}`}>{t.email} {SITE.email}</a>
  <span>{t.orCall} <a href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a></span>
</p>

<style>
  .reach {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
</style>

---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import ContactLinks from '../../components/ContactLinks.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config';
import { graph, service } from '../../utils/structured-data';

export const getStaticPaths = (async () => {
  const services = await getCollection('services');
  return services.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
---

<BaseLayout title={data.title} description={data.description} structuredData={graph(service(entry))}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/services/">Services</a>
  </nav>
  <article class="prose">
    <h1>{data.title}</h1>
    <p class="lede">{data.summary}</p>
    <ul>
      {data.skills.map((skill) => <li>{skill}</li>)}
    </ul>
    <Content />
  </article>

  <section class="contact" aria-labelledby="contact">
    <h2 id="contact">Start a conversation</h2>
    <p>
      Based in {SITE.locality}, working remotely or on-site.
      See <a href="/work/">selected projects</a> or write to me directly.
    </p>
    <ContactLinks />
  </section>
</BaseLayout>

<style>
  .crumbs {
    margin-top: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  article h1 {
    margin-top: var(--space-2);
  }

  .contact {
    max-width: var(--measure);
    margin-top: var(--space-5);
  }
</style>

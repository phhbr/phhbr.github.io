---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { formatDate } from '../../../utils/date';
import { postPath, writingPath } from '../../../i18n';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  alternates={{ en: writingPath }}
  title="Writing"
  description="Posts by Philipp Bruchner on relaunching this site and on freelancing as a frontend engineer, plus archived notes from the years before."
>
  <h1 class="page-title">Writing</h1>
  <p class="muted">Posts from before the 2026 relaunch are archived and no longer updated.</p>
  <ul class="ruled">
    {
      posts.map(({ id, data }) => (
        <li>
          <time class="label" datetime={data.pubDate.toISOString()}>
            {formatDate(data.pubDate)}
          </time>
          <span>
            <a href={postPath(id)}>{data.title}</a>
            {data.archived && <span class="muted"> (archived)</span>}
          </span>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .page-title {
    margin-top: var(--space-5);
  }

  .ruled {
    margin-top: var(--space-3);
  }
</style>

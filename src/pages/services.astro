---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Services" description="What I offer as a freelance software engineer and how I work.">
  <h1 class="page-title">Services</h1>
  <p class="lede">
    I join teams as a senior engineer or advise them from the outside, on the frontend and on the
    tooling around it.
  </p>

  {
    services.map(({ data }) => (
      <section class="service">
        <h2>{data.title}</h2>
        <p>{data.summary}</p>
        <ul>
          {data.skills.map((skill) => (
            <li>{skill}</li>
          ))}
        </ul>
      </section>
    ))
  }

  <section aria-labelledby="engagement">
    <h2 id="engagement">Ways to work together</h2>
    <ul class="ruled">
      <li><span class="label">Greenfield</span><span>Setting up solid foundations for a new product.</span></li>
      <li><span class="label">Modernisation</span><span>Moving a legacy frontend forward with careful planning and execution.</span></li>
      <li><span class="label">Team augmentation</span><span>Extra senior capacity for critical frontend or full-stack work.</span></li>
      <li><span class="label">Consulting</span><span>Architecture decisions, reviews and a second opinion.</span></li>
    </ul>
    <p class="muted where">Based in Germany (CET). Remote, or on-site within reasonable travel distance.</p>
  </section>

  <section class="contact" aria-labelledby="contact">
    <h2 id="contact">Start a conversation</h2>
    <p><a class="button" href={`mailto:${SITE.email}`}>Email {SITE.email}</a></p>
  </section>
</BaseLayout>

<style>
  .page-title {
    margin-top: var(--space-5);
  }

  .service {
    max-width: var(--measure);
  }

  .service ul {
    padding-left: 1.25rem;
  }

  .where {
    margin-top: var(--space-2);
  }

  .contact {
    margin-top: var(--space-5);
  }
</style>

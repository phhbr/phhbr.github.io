---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactLinks from '../components/ContactLinks.astro';
import Hero from '../components/Hero.astro';
import Testimonial from '../components/Testimonial.astro';
import { testimonials } from '../data/cv';
import { projects } from '../data/work';
import { graph, person, professionalService, website } from '../utils/structured-data';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout structuredData={graph(person(), professionalService(services), website())}>
  <Hero />

  <section aria-labelledby="services">
    <h2 id="services">What I do</h2>
    <ul class="ruled">
      {
        services.map(({ id, data }) => (
          <li>
            <a class="label" href={`/services/${id}/`}>
              {data.title}
            </a>
            <span>{data.summary}</span>
          </li>
        ))
      }
    </ul>
    <p class="more"><a href="/services/">Services in detail</a></p>
  </section>

  <section aria-labelledby="work">
    <h2 id="work">Selected work</h2>
    <ul class="ruled projects">
      {
        projects.map(({ id, title, summary, client, period }) => (
          <li>
            <h3>
              <a href={`/work/#${id}`}>{title}</a>
            </h3>
            <p>{summary}</p>
            <p class="meta">
              {client}, {period}
            </p>
          </li>
        ))
      }
    </ul>
    <p class="more"><a href="/work/">All projects in detail</a></p>
  </section>

  <section aria-labelledby="feedback">
    <h2 id="feedback">What colleagues say</h2>
    <div class="quotes">
      {testimonials.map((t) => <Testimonial {...t} quote={t.highlight} />)}
    </div>
  </section>

  <section class="closing" aria-labelledby="contact">
    <h2 id="contact">Have a project in mind?</h2>
    <p>Tell me what you're building and where you're stuck.</p>
    <ContactLinks />
  </section>
</BaseLayout>

<style>
  .more {
    margin-top: var(--space-2);
  }

  .projects > li {
    display: block;
  }

  .projects h3 {
    margin: 0 0 0.35rem;
  }

  .projects p {
    max-width: var(--measure);
    margin-bottom: 0.35rem;
  }

  .projects .meta {
    margin: 0;
  }

  .quotes {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
  }

  .closing {
    margin-top: var(--space-6);
    padding: var(--space-4) var(--space-3);
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--surface);
  }

  .closing h2 {
    margin-top: 0;
  }
</style>

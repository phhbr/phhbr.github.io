---
import ThemeToggle from './ThemeToggle.astro';
import { SITE } from '../config';
import { langNames, langOf, langs, routes, ui, type Localized } from '../i18n';

interface Props {
  // This page in other languages; missing ones fall back to that language's home page.
  alternates: Partial<Localized>;
}

const lang = langOf(Astro.url);
const t = ui[lang];
const links = [
  { href: routes.services[lang], label: t.nav.services },
  { href: routes.work[lang], label: t.nav.work },
  { href: routes.cv[lang], label: t.nav.cv },
];
const current = Astro.url.pathname;
---

<header class="site-header wrap">
  <a class="wordmark" href={routes.home[lang]} aria-label={`${SITE.title}, ${t.home}`}>
    <span class="prompt" aria-hidden="true">~/</span>{SITE.title}
  </a>
  <nav class="main" aria-label={t.mainNav}>
    <ul>
      {
        links.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={current.startsWith(href) ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <nav class="langs" aria-label={t.languageNav}>
    <ul>
      {
        langs.map((l) => (
          <li>
            <a
              href={Astro.props.alternates[l] ?? routes.home[l]}
              hreflang={l}
              lang={l}
              aria-current={l === lang ? 'true' : undefined}
            >
              <span aria-hidden="true">{l.toUpperCase()}</span>
              <span class="visually-hidden">{langNames[l]}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <ThemeToggle />
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-4);
    padding-block: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .wordmark {
    margin-right: auto;
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }

  .prompt {
    color: var(--accent);
  }

  ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .main ul {
    gap: var(--space-3);
  }

  .main a {
    color: var(--ink);
    text-decoration: none;
  }

  .main a:hover,
  .main a[aria-current='page'] {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  /* Language switch: a two-segment control, the current language filled. */
  .langs ul {
    border: 1px solid var(--rule);
    border-radius: 3px;
  }

  .langs a {
    display: block;
    padding: 0.15rem 0.5rem;
    color: var(--muted);
    text-decoration: none;
  }

  .langs a:hover {
    color: var(--ink);
  }

  .langs a[aria-current='true'] {
    background: var(--ink);
    color: var(--bg);
    font-weight: 600;
  }

  .langs li:first-child a[aria-current='true'] {
    border-radius: 2px 0 0 2px;
  }

  .langs li:last-child a[aria-current='true'] {
    border-radius: 0 2px 2px 0;
  }

  /* Narrow screens: wordmark, language switch and theme toggle share the first
     row, the main links the second. */
  @media (max-width: 40rem) {
    .site-header {
      column-gap: var(--space-2);
    }

    .main {
      order: 1;
      flex-basis: 100%;
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Testimonial from '../components/Testimonial.astro';
import { profilePage } from '../utils/structured-data';
import {
  certificates,
  education,
  experience,
  profile,
  teaching,
  testimonials,
  trainings,
  type Role,
} from '../data/cv';

const timelines: { heading: string; entries: Role[] }[] = [
  { heading: 'Experience', entries: experience },
  { heading: 'Education', entries: education },
  { heading: 'Trainer and speaker', entries: teaching },
  { heading: 'Trainings', entries: trainings },
  { heading: 'Certificates', entries: certificates },
];
---

<BaseLayout
  title="CV: Senior Frontend Engineer"
  description="CV of Philipp Bruchner, freelance senior frontend engineer in Nürnberg: design systems, accessibility, Angular and TypeScript, trainings and certificates."
  structuredData={{ '@context': 'https://schema.org', ...profilePage() }}
>
  <h1 class="page-title">Curriculum vitae</h1>
  <p>Project details are on the <a href="/work/">work</a> page.</p>

  <section aria-labelledby="profile">
    <h2 id="profile" class="visually-hidden">Profile</h2>
    <ul class="ruled">
      <li><span class="label">Role</span><span>{profile.role}</span></li>
      <li><span class="label">Focus</span><span>{profile.focus.join(', ')}</span></li>
      <li><span class="label">Core skills</span><span>{profile.coreSkills.join(', ')}</span></li>
    </ul>
  </section>

  {
    timelines.map(({ heading, entries }) => (
      <section>
        <h2>{heading}</h2>
        <ul class="ruled">
          {entries.map(({ period, title }) => (
            <li>
              <span class="label">{period}</span>
              <span>{title}</span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <section aria-labelledby="recommendations">
    <h2 id="recommendations">Recommendations</h2>
    <div class="quotes">
      {testimonials.map((t) => <Testimonial {...t} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .page-title {
    margin-top: var(--space-5);
  }

  .quotes {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
  }
</style>

---
import type { Testimonial } from '../data/cv';

type Props = Testimonial;
const { quote, role, company } = Astro.props;
---

<figure class="testimonial">
  <blockquote>
    <p>{quote}</p>
  </blockquote>
  <figcaption>{role}, {company}</figcaption>
</figure>

<style>
  .testimonial {
    margin: 0;
    padding-left: var(--space-3);
    border-left: 2px solid var(--accent);
  }

  blockquote {
    margin: 0 0 var(--space-1);
  }

  blockquote p {
    margin: 0;
    font-size: var(--step-0);
  }

  blockquote p::before {
    content: '“';
  }

  blockquote p::after {
    content: '”';
  }

  figcaption {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
</style>

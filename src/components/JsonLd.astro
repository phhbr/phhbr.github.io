---
// Renders structured data (src/utils/structured-data.ts). A JSON data block is
// never executed, so the CSP and the inline-code guard allow it.
interface Props {
  data: object;
}

// Escape `<` so no value can ever close the script element.
const json = JSON.stringify(Astro.props.data).replace(/</g, '\\u003c');
---

<script type="application/ld+json" set:html={json} />

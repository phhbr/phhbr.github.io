---
import { SITE } from '../config';

// The name is presented as if selected in the browser's element inspector. The
// tooltip is decorative (aria-hidden) but truthful: the values are the real
// ones for this heading, including the measured contrast in each theme.
---

<section class="hero" aria-labelledby="hero-name">
  <div class="inspect">
    <h1 id="hero-name" class="name">{SITE.author}</h1>

    <div class="tip" aria-hidden="true">
      <p class="tip-head">
        <span class="tag">h1</span><span class="cls">.name</span>
      </p>
      <dl>
        <dt>Font</dt>
        <dd>Martian Mono</dd>
        <dt>Color</dt>
        <dd>
          <span class="swatch"></span>
          <span class="only-light">#14212E</span><span class="only-dark">#DCE4EE</span>
        </dd>
      </dl>
      <p class="tip-section">Accessibility</p>
      <dl>
        <dt>Contrast</dt>
        <dd>
          <span class="aa">Aa</span>
          <span class="only-light">14.38</span><span class="only-dark">14.19</span>
          <svg class="pass" width="12" height="12" viewBox="0 0 12 12">
            <circle cx="6" cy="6" r="6"></circle>
            <path d="M3.2 6.2l1.9 1.9 3.7-3.9"></path>
          </svg>
        </dd>
        <dt>Name</dt>
        <dd>{SITE.author}</dd>
        <dt>Role</dt>
        <dd>heading</dd>
        <dt>Keyboard-focusable</dt>
        <dd>
          <svg class="no" width="12" height="12" viewBox="0 0 12 12">
            <circle cx="6" cy="6" r="5"></circle>
            <path d="M2.5 9.5l7-7"></path>
          </svg>
        </dd>
      </dl>
    </div>
  </div>

  <p class="lede">
    Freelance software engineer. I build TypeScript frontends, design systems and the pipelines that
    ship them, with accessibility designed in rather than bolted on.
  </p>
  <p class="status"><span class="dot" aria-hidden="true"></span>Available for new projects, remote or on-site in Germany.</p>
  <p class="actions">
    <a class="button" href={`mailto:${SITE.email}`}>Email me</a>
    <a href="/services/">See what I offer</a>
  </p>
</section>

<style>
  .hero {
    padding-block: var(--space-5) var(--space-4);
  }

  .inspect {
    position: relative;
    margin-bottom: var(--space-4);
  }

  .name {
    position: relative;
    width: fit-content;
    margin: 0;
    font-size: var(--step-hero);
    font-stretch: 112.5%;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    background: var(--highlight);
    outline: 1px solid color-mix(in srgb, var(--accent) 55%, transparent);
  }

  /* Inspector guide lines along the top and bottom edge, across the viewport. */
  .name::before,
  .name::after {
    content: '';
    position: absolute;
    left: -100vw;
    right: -100vw;
    border-top: 1px dashed color-mix(in srgb, var(--accent) 45%, transparent);
    pointer-events: none;
  }

  .name::before {
    top: 0;
  }

  .name::after {
    bottom: 0;
  }

  .tip {
    position: relative;
    width: max-content;
    max-width: 100%;
    margin-top: 12px;
    padding: 0.6rem 0.8rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--surface);
    box-shadow: 0 2px 8px color-mix(in srgb, var(--ink) 12%, transparent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  /* Pointer towards the highlighted heading. */
  .tip::before {
    content: '';
    position: absolute;
    top: -6px;
    left: 1.25rem;
    width: 10px;
    height: 10px;
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
    background: var(--surface);
    transform: rotate(45deg);
  }

  .tip-head {
    margin: 0 0 0.4rem;
    font-weight: 700;
  }

  .tag {
    color: var(--accent);
  }

  .cls {
    color: var(--ink);
  }

  .tip-section {
    margin: 0.5rem 0 0.2rem;
    padding-top: 0.4rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
  }

  dl {
    display: grid;
    grid-template-columns: auto auto;
    gap: 0.1rem 2rem;
    margin: 0;
  }

  dt {
    color: var(--muted);
  }

  dd {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
    margin: 0;
  }

  .swatch {
    width: 0.7rem;
    height: 0.7rem;
    border: 1px solid var(--rule);
    background: var(--ink);
  }

  .aa {
    padding: 0 0.2rem;
    border: 1px solid var(--rule);
    background: var(--bg);
    color: var(--ink);
    font-size: 0.65rem;
  }

  .pass circle {
    fill: light-dark(#1a7f37, #3fb950);
  }

  .pass path {
    fill: none;
    stroke: var(--surface);
    stroke-width: 1.6;
  }

  .no circle,
  .no path {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.3;
  }

  .lede {
    margin-bottom: var(--space-3);
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--muted);
  }

  .dot {
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: light-dark(#1a7f37, #3fb950);
    box-shadow: 0 0 0 3px color-mix(in srgb, light-dark(#1a7f37, #3fb950) 22%, transparent);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-3);
  }

  /* One orchestrated moment: the inspector tooltip appears once the page settles. */
  @media (prefers-reduced-motion: no-preference) {
    .tip {
      animation: tip-in 240ms ease-out 500ms both;
    }

    @keyframes tip-in {
      from {
        opacity: 0;
        translate: 0 -4px;
      }
    }
  }
</style>
